--- Option type and constructors.
--- @details
--- The `option` package provides the `Option<T>` type and the `some`
--- / `none` constructors over the canonical `__ctor__` object shape
--- (ADR-0152 §2 — the post-`__tag__` mint, phase-3 WS-F).
---
--- `some(v)` mints `{"__ctor__": some, value: v, type: Option}` — the
--- same record an `Option := new Inductive { some : (value : a) ~> Option(a), none : Option(a) }` declaration
--- produces — so `match` dispatches on ctor-sym identity
--- (`match v { some(x): …, None: … }`), never a `__tag__` string. The
--- mint stays manual rather than an inductive declaration because a
--- family record's constructors bind module scope but produce no
--- `export` record entry beyond the family name (the export transform
--- is text-level); once `export` projects constructor names this file
--- becomes `Option := new Inductive { … }`.

--- @template T - the value type
--- The `Option<T>` type.
--- @details
--- An `Option<T>` is either `none` or `some(value: T)`.
export Option<T> := (t) ~> type.Type()

--- Construct a `some` option wrapping a value.
--- @param {value} - the value of type T
--- @returns {Option<T>}
export some<T>: T ~>[1] Option<T> := (value: T) ~> do {
  { "__ctor__": sym.seeded("data.Option.some"),
    "value": value,
    "type": { "__former__": sym.seeded("data.Option"), "indices": [null] } }
}

--- Construct a `none` option.
--- @returns {Option<T>}
export none<T>: () ~>[1] Option<T> := () ~> do {
  { "__ctor__": sym.seeded("data.Option.none"),
    "type": { "__former__": sym.seeded("data.Option"), "indices": [null] } }
}

--- The nullary `None` ctor *value* — bound so `match v { None: … }`
--- discriminates by equality (a 0-argument ctor pattern resolves
--- through scope to its `{"__ctor__": …}` object; ADR-0152 §2).
export None := none()

--- `some` re-exported under a capitalized alias so `option.Some`
--- reads like the inductive-declared surface. Match patterns dispatch
--- on the ctor sym's leaf — the lowercase `some` — so write
--- `match v { some(x): … }`, not `Some(x)`; this alias is for
--- value-position uses only.
export Some := some
